rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Ruxsat ro'yxati (allowlist) ----
    // Faqat shu ikkita Firebase Auth akkaunt kira oladi:
    //   OWNER_UID  = sening akkaunting (sayt)
    //   CLAUDE_UID = Claude'ning MCP akkaunti (Vercel'dagi server shu bilan kiradi)
    // UID'ni Firebase Console -> Authentication -> Users -> "User UID" ustunidan nusxala.
    // Placeholder almashtirilmasa hech kim kira olmaydi (yopiq holat).
    // Boshqa odam qo'shish yoki olib tashlash = ro'yxatni o'zgartirib qayta Publish qilish.
    function isAllowed() {
      return request.auth != null
          && request.auth.uid in ['OWNER_UID', 'CLAUDE_UID'];
    }

    function isValidCheckin(data) {
      return data.keys().hasOnly(['vaqt', 'holat', 'timestamp'])
          && data.vaqt is string
          && data.vaqt.size() > 0
          && data.vaqt.size() < 30
          && data.holat is string
          && data.holat.size() > 0
          && data.holat.size() < 500
          && data.timestamp is timestamp;
    }

    match /checkins/{docId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidCheckin(request.resource.data);
      // Log immutable: eski yozuvni hech kim o'zgartira yoki o'chira olmaydi.
      allow update, delete: if false;
    }

    // Qolgan hamma narsa yopiq (config/access ham: parol hash'i endi Firestore'da yo'q).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
