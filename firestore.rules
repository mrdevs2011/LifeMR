rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Endi hamma narsa serverdan o'tadi (sayt ham, /mcp ham, Claude ham).
    // Firestore'ga faqat server kiradi, Claude akkaunti bilan. Boshqa hech kim (egasi akkaunti ham) to'g'ridan-to'g'ri kira olmaydi.
    function isClaude() {
      return request.auth != null && request.auth.uid == 'iMuJhsmeu1Xt6SJBE1fai3ure3F3';
    }

    function isValidCheckin(data) {
      return data.keys().hasOnly(['vaqt', 'holat', 'timestamp'])
          && data.vaqt is string
          && data.vaqt.size() > 0
          && data.vaqt.size() < 30
          && data.holat is string
          && data.holat.size() > 0
          && data.holat.size() < 500
          && data.timestamp is timestamp;
    }

    // level/until ixtiyoriy: rules va kodni istalgan tartibda deploy qilsa bo'ladi.
    function isValidGuard(data) {
      return data.keys().hasOnly(['hits', 'blocked', 'ts', 'level', 'until'])
          && data.hits is list
          && data.hits.size() <= 3
          && data.blocked is bool
          && data.ts is timestamp
          && (!('level' in data) || (data.level is int && data.level >= 0 && data.level <= 100))
          && (!('until' in data) || data.until == null || data.until is timestamp);
    }

    // Dars jadvali: bitta doimiy hujjat (jadval/main). "cells" — katak kaliti -> matn (masalan
    // mon_1 -> "Sinf soati"). Aniq kalitlarni server (api/jadval.js) tekshiradi, bu yerda faqat
    // umumiy shakl (map, oqilona hajm) va updated_at tekshiriladi.
    function isValidJadval(data) {
      return data.keys().hasOnly(['cells', 'updated_at'])
          && data.cells is map
          && data.cells.size() <= 48
          && data.updated_at is timestamp;
    }

    // Login vaqti: bitta hujjat, ikkita qat'iy maydon (before/now). "before" birinchi
    // login'da hali bo'lmasligi mumkin, shuning uchun null ham qabul qilinadi.
    function isValidLoginMeta(data) {
      return data.keys().hasOnly(['before', 'now'])
          && (data.before is timestamp || data.before == null)
          && data.now is timestamp;
    }

    match /checkins/{docId} {
      allow read: if isClaude();
      allow create: if isClaude() && isValidCheckin(request.resource.data);
      // Log immutable: eski yozuvni hech kim o'zgartira yoki o'chira olmaydi.
      allow update, delete: if false;
    }

    // IP bloklash hisobi. Bloklangan IP'ni ochish: Firebase Console -> Firestore -> ipguard -> hujjatni o'chir
    // (Console rules'ni chetlab o'tadi).
    match /ipguard/{id} {
      allow read: if isClaude();
      allow create, update: if isClaude() && isValidGuard(request.resource.data);
      allow delete: if false;
    }

    match /jadval/{id} {
      allow read: if isClaude();
      allow create, update: if isClaude() && isValidJadval(request.resource.data);
      allow delete: if false;
    }

    // Login vaqti (before/now) — bitta doimiy hujjat, har login'da ustidan yoziladi.
    match /meta/{id} {
      allow read: if isClaude();
      allow create, update: if isClaude() && isValidLoginMeta(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
